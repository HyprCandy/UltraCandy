{ 
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    /*"source": "$(find \"${XDG_CONFIG_HOME:-$HOME/.config}/fastfetch/pngs/\" -name \"*.png\" | shuf -n 1)",
    "height": 15,
    "width": 35,*/
      "padding": {
      "top": 6,
      /*"left": 0,
      "right": 1*/
      }
  },
  "display": {
        "separator": " "
  },
    "modules": [
        {
            "key": "╭───────────╮╭───────────────────────────────────────────────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#32} user    {#keys}││ ",
            "type": "title",
            "format": "User  {user-name}  Root  {host-name}"
        },
        {
            "key": "│ {#32}󰇄 device  {#keys}││ ",
            "type": "host",
            "format": "{5} {2}"
        },
        {
            "key": "│ {#35}{icon} distro  {#keys}││ ",
            "type": "os"
        },
        {
            "key": "│ {#34} kernel  {#keys}││ ",
            "type": "kernel"
        },
        {
            "key": "│ {#33}󱫐 wm      {#keys}││ ",
            "type": "wm"
        },
        {
            "key": "│ {#36} cursor  {#keys}││ ",
            "type": "cursor"
        },
        {
            "key": "│ {#39}󰀻 icons   {#keys}││ ",
            "type": "icons"
        },
        {
            "key": "│ {#31} term    {#keys}││ ",
            "type": "terminal"
        },
        {
            "key": "│ {#31} shell   {#keys}││ ",
            "type": "shell"
        },
        {
            "key": "│ {#39}󰏗 packages{#keys}││ ",
            "type": "packages"
        },
        {
            "key": "│ {#36}󰉉 disk    {#keys}││ ",
            "type": "disk"
        },
        {
            "key": "│ {#33} memory  {#keys}││ ",
            "type": "memory"
        },
        {
            "key": "│ {#33}󰓡 swap    {#keys}││ ",
            "type": "swap"
        },
        {
            "key": "│ {#34}󰅐 os age  {#keys}││ ",
            "type": "disk",
            "folders": "/",
            "format": "{days} days"
        },
        {
            "key": "│ {#34}󰅐 uptime  {#keys}││ ",
            "type": "uptime"
        },
        {
            "key": "│ {#35}󰍛 cpu     {#keys}││ ",
            "type": "cpu",
            "showPeCoreCount": true
        },
        {
            "key": "│ {#32}󰇺 gpu     {#keys}││ ",
            "type": "gpu",
            "format": "{1}  Driver : {3}"
        },
        {
            "key": "╰───────────╯╰───────────────────────────────────────────────────╯",
            "type": "custom"
        },
        {
            "key": "╭───────────╮╭───────────────────────────────────────────────────╮",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}││                 ",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯╰───────────────────────────────────────────────────╯",
            "type": "custom"
        },
    ]
}
